{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/021-events.schema.json",
  "title": "021 — події",
  "$defs": {
    "venue_ref": {
      "description": "Де відбувається подія. place_id заповнено, якщо майданчик є місцем у каталозі.",
      "type": "object",
      "additionalProperties": false,
      "required": ["place_id", "title", "address", "location"],
      "properties": {
        "place_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1 },
        "address": { "type": ["string", "null"] },
        "location": { "anyOf": [{ "$ref": "common.schema.json#/$defs/geo_point" }, { "type": "null" }] }
      }
    },
    "event_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "image", "categories", "venue", "starts_at", "ends_at", "next_session_at", "sessions_count",
        "price", "age_limit", "status", "badges", "is_promoted", "ending_soon", "distance_m"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "image": { "anyOf": [{ "$ref": "common.schema.json#/$defs/image" }, { "type": "null" }] },
        "categories": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" } },
        "venue": { "$ref": "#/$defs/venue_ref" },
        "starts_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "ends_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "next_session_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "sessions_count": { "type": "integer", "minimum": 0 },
        "price": { "anyOf": [{ "$ref": "common.schema.json#/$defs/price" }, { "type": "null" }] },
        "age_limit": { "type": ["integer", "null"], "minimum": 0, "maximum": 21 },
        "status": { "enum": ["scheduled", "rescheduled", "cancelled"] },
        "badges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/badge" } },
        "is_promoted": { "type": "boolean" },
        "promotion_id": {
          "description": "З версії 0.3.0 (спека 166-promotions): ідентифікатор просування, якщо is_promoted дорівнює true; інакше null. Для подій аналітики (066).",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "ending_soon": { "type": "boolean" },
        "distance_m": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "starts_at", "ends_at", "venue", "hall", "price", "ticket_url", "status", "attributes"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "starts_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "ends_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "venue": { "anyOf": [{ "$ref": "#/$defs/venue_ref" }, { "type": "null" }] },
        "hall": { "type": ["string", "null"] },
        "price": { "anyOf": [{ "$ref": "common.schema.json#/$defs/price" }, { "type": "null" }] },
        "ticket_url": { "anyOf": [{ "$ref": "common.schema.json#/$defs/url" }, { "type": "null" }] },
        "status": { "enum": ["scheduled", "rescheduled", "cancelled", "sold_out"] },
        "attributes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/attribute" } }
      }
    },
    "list_events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "generated_at"],
      "properties": {
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/event_card" } },
        "next_cursor": { "type": ["string", "null"] },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "list_event_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "truncated", "generated_at"],
      "properties": {
        "points": { "type": "array", "maxItems": 500, "items": { "$ref": "common.schema.json#/$defs/map_point" } },
        "truncated": { "type": "boolean" },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "get_events_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feed", "items", "generated_at"],
      "properties": {
        "feed": { "enum": ["today", "ending_soon"] },
        "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/event_card" } },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "get_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card", "description", "images", "sessions", "sessions_truncated", "ticket_url", "status_note",
        "attributes", "source", "share_url", "updated_at", "generated_at"
      ],
      "properties": {
        "card": { "$ref": "#/$defs/event_card" },
        "description": { "type": ["string", "null"] },
        "images": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/image" } },
        "sessions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/session" } },
        "sessions_truncated": { "type": "boolean" },
        "ticket_url": { "anyOf": [{ "$ref": "common.schema.json#/$defs/url" }, { "type": "null" }] },
        "status_note": { "type": ["string", "null"] },
        "attributes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/attribute" } },
        "source": { "anyOf": [{ "$ref": "common.schema.json#/$defs/source" }, { "type": "null" }] },
        "share_url": { "$ref": "common.schema.json#/$defs/url" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
