{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/087-rewards.schema.json",
  "title": "087 — сертифікати й прикраси профілю",
  "$defs": {
    "reward_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "image",
        "partner",
        "price_points",
        "valid_days",
        "stock_left",
        "per_user_limit",
        "already_owned"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "certificate",
            "cosmetic"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "title"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "place",
                    "family"
                  ]
                },
                "id": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "price_points": {
          "type": "integer",
          "minimum": 1
        },
        "valid_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stock_left": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "per_user_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "already_owned": {
          "description": "Для прикраси: чи вже є вона в користувача (для гостя й неучасника false); для сертифіката null.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "refund_points": {
      "description": "Що станеться з балами під час повернення сертифіката (рішення 94): returns — повернуться на баланс, expires — згорять одразу, бо їхній строк уже минув.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returns",
        "expires"
      ],
      "properties": {
        "returns": {
          "type": "integer",
          "minimum": 0
        },
        "expires": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "list_rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor",
        "generated_at"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward_card"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "my_reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reward",
        "status",
        "code_payload",
        "code_text",
        "purchased_at",
        "valid_until",
        "refundable_until",
        "refund_points",
        "partner_leaves_at",
        "redeemed_at",
        "redeemed_place_title",
        "is_applied",
        "generated_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "reward": {
          "$ref": "#/$defs/reward_card"
        },
        "status": {
          "enum": [
            "active",
            "blocked_by_debt",
            "redeemed",
            "refunded",
            "expired"
          ]
        },
        "code_payload": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "purchased_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "valid_until": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "refundable_until": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "refund_points": {
          "anyOf": [
            {
              "$ref": "#/$defs/refund_points"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner_leaves_at": {
          "description": "Коли заклад (фемілі) сертифіката виходить із програми; після цього сертифікат не гаситься, а бали повертаються автоматично (рішення 101). null, якщо виходу не заплановано.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "redeemed_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "redeemed_place_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_applied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "description": "Звідки сертифікат. Відсутній у даних до версії 0.6.0: тоді це купівля балами.",
          "enum": ["points", "stamp", "second_visit", "offer", "campaign"]
        },
        "generated_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "buy_reward": {
      "$ref": "#/$defs/my_reward"
    },
    "get_my_reward": {
      "$ref": "#/$defs/my_reward"
    },
    "refund_reward": {
      "$ref": "#/$defs/my_reward"
    },
    "apply_cosmetic": {
      "$ref": "#/$defs/my_reward"
    },
    "my_reward_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reward",
        "status",
        "purchased_at",
        "valid_until",
        "is_applied"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "reward": {
          "$ref": "#/$defs/reward_card"
        },
        "status": {
          "enum": [
            "active",
            "blocked_by_debt",
            "redeemed",
            "refunded",
            "expired"
          ]
        },
        "purchased_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "valid_until": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_applied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "description": "Звідки сертифікат. Відсутній у даних до версії 0.6.0: тоді це купівля балами.",
          "enum": ["points", "stamp", "second_visit", "offer", "campaign"]
        }
      }
    },
    "list_my_rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor",
        "generated_at"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/my_reward_item"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
