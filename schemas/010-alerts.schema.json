{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/010-alerts.schema.json",
  "title": "010 — тривога",
  "$defs": {
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {
          "enum": ["air_raid", "recon_uav", "artillery", "urban_fights", "chemical", "nuclear", "unknown"]
        },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "get_alert_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "community", "level", "is_active", "threat", "started_at", "ended_at",
        "source_updated_at", "stale_after_seconds", "poll_interval_seconds", "state_version", "generated_at"
      ],
      "properties": {
        "community": { "$ref": "common.schema.json#/$defs/community" },
        "level": { "enum": ["green", "yellow", "red", "unknown"] },
        "is_active": { "type": ["boolean", "null"] },
        "threat": { "anyOf": [{ "$ref": "#/$defs/threat" }, { "type": "null" }] },
        "started_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "ended_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "source_updated_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "stale_after_seconds": { "type": "integer", "minimum": 30 },
        "poll_interval_seconds": { "type": "integer", "minimum": 10 },
        "state_version": { "type": "integer", "minimum": 0 },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "realtime_state": {
      "description": "Повідомлення каналу реального часу. Та сама форма, що й відповідь get_alert_state.",
      "$ref": "#/$defs/get_alert_state"
    }
  }
}
