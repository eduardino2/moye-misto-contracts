{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/080-analytics.schema.json",
  "title": "080 — події аналітики",
  "$defs": {
    "track_events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "description": "Один елемент параметра p_events.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "occurred_at", "props"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "name": {
          "enum": [
            "app_open", "screen_view", "tile_click", "category_open", "filter_apply", "search",
            "item_view", "ticket_click", "contact_click", "route_click", "share_click",
            "map_layer_toggle", "offline_map_download"
          ]
        },
        "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "props": { "type": "object" }
      }
    },
    "events_batch": {
      "description": "Значення параметра p_events.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/event" }
    }
  }
}
