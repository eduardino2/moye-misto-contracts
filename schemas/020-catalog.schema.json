{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/020-catalog.schema.json",
  "title": "020 — каталог: розділи, категорії, фільтри",
  "$defs": {
    "filter_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "title"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "filter_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "step", "unit"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "minimum": 0 },
        "unit": { "type": ["string", "null"] }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "type", "quick", "options", "range"],
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["toggle", "single_select", "multi_select", "range"] },
        "quick": { "type": "boolean" },
        "options": {
          "anyOf": [
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/filter_option" } },
            { "type": "null" }
          ]
        },
        "range": { "anyOf": [{ "$ref": "#/$defs/filter_range" }, { "type": "null" }] }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "icon", "item_kind", "sort_options", "default_sort", "supports_map_view", "filters"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "slug": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "common.schema.json#/$defs/icon" },
        "item_kind": { "enum": ["event", "place"] },
        "sort_options": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["date", "distance", "popular", "title"] }
        },
        "default_sort": { "enum": ["date", "distance", "popular", "title"] },
        "supports_map_view": { "type": "boolean" },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "item_kind", "categories"],
      "properties": {
        "slug": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "item_kind": { "enum": ["event", "place"] },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } }
      }
    },
    "get_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city_id", "version", "not_modified", "sections", "generated_at"],
      "properties": {
        "city_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "not_modified": { "type": "boolean" },
        "sections": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/section" } },
            { "type": "null" }
          ]
        },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
