{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/001-conventions.schema.json",
  "title": "001 — загальні правила",
  "$defs": {
    "error": {
      "description": "Тіло відповіді з помилкою. Додаток читає лише поле message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details", "hint"],
      "properties": {
        "code": { "type": "string" },
        "message": {
          "enum": ["invalid_argument", "not_found", "city_not_found", "rate_limited", "update_required", "internal", "unauthenticated", "forbidden", "conflict"]
        },
        "details": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "timezone", "center", "bounds", "default_community", "enabled_tabs"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "slug": { "$ref": "common.schema.json#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "center": { "$ref": "common.schema.json#/$defs/geo_point" },
        "bounds": { "$ref": "common.schema.json#/$defs/bounds" },
        "default_community": { "$ref": "common.schema.json#/$defs/community" },
        "enabled_tabs": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["home", "entertainment", "map", "civic", "profile"] }
        }
      }
    },
    "get_app_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "server_time", "app", "default_city_id", "cities", "contacts", "legal", "generated_at"],
      "properties": {
        "contract_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "server_time": { "$ref": "common.schema.json#/$defs/timestamp" },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_supported_version", "latest_version", "update_required", "store_url"],
          "properties": {
            "min_supported_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "latest_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "update_required": { "type": "boolean" },
            "store_url": { "anyOf": [{ "$ref": "common.schema.json#/$defs/url" }, { "type": "null" }] }
          }
        },
        "default_city_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "cities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/city" } },
        "contacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["support_email", "support_url", "partner_url"],
          "properties": {
            "support_email": { "type": ["string", "null"] },
            "support_url": { "anyOf": [{ "$ref": "common.schema.json#/$defs/url" }, { "type": "null" }] },
            "partner_url": { "anyOf": [{ "$ref": "common.schema.json#/$defs/url" }, { "type": "null" }] }
          }
        },
        "legal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privacy_policy_url", "terms_url", "alert_disclaimer"],
          "properties": {
            "privacy_policy_url": { "$ref": "common.schema.json#/$defs/url" },
            "terms_url": { "$ref": "common.schema.json#/$defs/url" },
            "alert_disclaimer": { "type": "string", "minLength": 1 }
          }
        },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
