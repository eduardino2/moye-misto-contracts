{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.moyemisto.example/schemas/022-places.schema.json",
  "title": "022 — місця і сервіси",
  "$defs": {
    "open_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "changes_at"],
      "properties": {
        "state": { "enum": ["open", "closed", "always_open", "unknown"] },
        "changes_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "url"],
      "properties": {
        "type": { "enum": ["phone", "telegram", "viber", "whatsapp", "instagram", "facebook", "website", "email"] },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^(tel:\\+?[0-9]+|mailto:.+|https://.+|viber://.+)$" }
      }
    },
    "place_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "image", "categories", "address", "district", "location", "location_approximate",
        "open_status", "price_text", "contacts", "badges", "is_promoted", "distance_m", "verified_at"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "image": { "anyOf": [{ "$ref": "common.schema.json#/$defs/image" }, { "type": "null" }] },
        "categories": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" } },
        "address": { "type": ["string", "null"] },
        "district": { "type": ["string", "null"] },
        "location": { "anyOf": [{ "$ref": "common.schema.json#/$defs/geo_point" }, { "type": "null" }] },
        "location_approximate": { "type": "boolean" },
        "open_status": { "$ref": "#/$defs/open_status" },
        "price_text": { "type": ["string", "null"] },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "badges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/badge" } },
        "is_promoted": { "type": "boolean" },
        "distance_m": { "type": ["integer", "null"], "minimum": 0 },
        "verified_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/local_date" }, { "type": "null" }] }
      }
    },
    "time_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/local_time" },
        "to": { "$ref": "common.schema.json#/$defs/local_time" }
      }
    },
    "opening_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always_open", "weekly", "exceptions", "note"],
      "properties": {
        "always_open": { "type": "boolean" },
        "weekly": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "intervals"],
            "properties": {
              "day": { "type": "integer", "minimum": 1, "maximum": 7 },
              "intervals": { "type": "array", "items": { "$ref": "#/$defs/time_interval" } }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "closed", "intervals", "note"],
            "properties": {
              "date": { "$ref": "common.schema.json#/$defs/local_date" },
              "closed": { "type": "boolean" },
              "intervals": { "type": "array", "items": { "$ref": "#/$defs/time_interval" } },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "fuel_price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fuel", "title", "price", "updated_at"],
      "properties": {
        "fuel": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "price": { "type": "number", "minimum": 0 },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "list_places": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "generated_at"],
      "properties": {
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/place_card" } },
        "next_cursor": { "type": ["string", "null"] },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "list_place_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "truncated", "generated_at"],
      "properties": {
        "points": { "type": "array", "maxItems": 500, "items": { "$ref": "common.schema.json#/$defs/map_point" } },
        "truncated": { "type": "boolean" },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "get_place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card", "description", "images", "opening_hours", "attributes", "upcoming_events", "fuel_prices",
        "source", "share_url", "updated_at", "generated_at"
      ],
      "properties": {
        "card": { "$ref": "#/$defs/place_card" },
        "description": { "type": ["string", "null"] },
        "images": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/image" } },
        "opening_hours": { "anyOf": [{ "$ref": "#/$defs/opening_hours" }, { "type": "null" }] },
        "attributes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/attribute" } },
        "upcoming_events": { "type": "array", "maxItems": 5, "items": { "$ref": "021-events.schema.json#/$defs/event_card" } },
        "fuel_prices": { "type": "array", "items": { "$ref": "#/$defs/fuel_price" } },
        "source": { "anyOf": [{ "$ref": "common.schema.json#/$defs/source" }, { "type": "null" }] },
        "share_url": { "$ref": "common.schema.json#/$defs/url" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
